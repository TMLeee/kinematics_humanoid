{
	"folders": [
		{
			"name": "kin_humanoid",
			"path": ".."
		}
	],
	"settings": {
		"C_Cpp.default.cppStandard": "c++17",
		"C_Cpp.default.cStandard": "c17",
		"files.associations": {
			"*.h": "cpp",
			"*.hpp": "cpp"
		},
		"files.exclude": {
			"**/*.o": true,
			"**/*.obj": true
		},
		"search.exclude": {
			"kin_humanoid/model/dyros_tocabi_v2/**": true,
			"**/build/**": true
		}
	},
	"extensions": {
		"recommendations": [
			"ms-vscode.cpptools"
		]
	}
}
